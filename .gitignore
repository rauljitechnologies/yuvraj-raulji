.DS_Store
Thumbs.db
*.log
node_modules
.next*
out/
.claude/

# Incremental TypeScript build cache — rewritten by every tsc/next build, so
# tracking it produced a ~260 kB single-line diff on unrelated commits.
tsconfig.tsbuildinfo

# node_modules lives in a .nosync dir so iCloud cannot evict its contents.
# Dataless files there read as empty modules and hang every next build/dev.
node_modules.nosync/
.quarantine-root-owned/

# Stray Next build output from a bad NEXT_DIST_DIR override (relative /private/tmp).
private/

# Bytecode from the Python build scripts. Created the moment one of them is
# imported rather than run, which is how it first appeared in a diff.
__pycache__/

# QA artefacts from scripts/qa-screenshots.mjs and scripts/lighthouse.mjs.
# 60 full-page screenshots at DPR 2 plus the Lighthouse reports is ~180 MB,
# which does not belong in git history. Regenerate with `npm run qa` and
# `npm run qa:lighthouse` after a build; both are deterministic.
qa-screenshots/
